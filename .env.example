# Entorno
ENVIRONMENT=development

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=markethub_db
POSTGRES_PORT=5432

# URL para la API
DATABASE_URL=postgresql://postgres:postgres@db:5432/markethub_db

# Seguridad / JWT
# Generar una clave segura con: openssl rand -hex 32
SECRET_KEY=cambiar_por_clave_secreta_segura_de_produccion
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7